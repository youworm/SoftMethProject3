<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<TabPane xmlns:fx="http://javafx.com/fxml" fx:controller="project3.Controller">

  <tabs>

    <!-- ADD STUDENT TAB -->
    <Tab text="Add Student">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="addFnameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="addLnameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="DOB (MM/DD/YYYY):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="addDobField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Major:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="addMajorField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Credits:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="addCreditsField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Residency:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
          <ToggleGroup fx:id="residencyGroup"/>
          <RadioButton text="Resident" toggleGroup="$residencyGroup"/>
          <RadioButton text="NonResident" toggleGroup="$residencyGroup"/>
          <RadioButton text="TriState" toggleGroup="$residencyGroup"/>
          <RadioButton text="International" toggleGroup="$residencyGroup"/>
        </HBox>

        <Button text="Add Student" onAction="#handleAddStudent"
                GridPane.rowIndex="6" GridPane.columnIndex="1"/>

      </GridPane>
    </Tab>

    <!-- REMOVE STUDENT TAB -->
    <Tab text="Remove Student">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="removeFnameField" promptText="First Name"/>
        <TextField fx:id="removeLnameField" promptText="Last Name"/>
        <TextField fx:id="removeDobField" promptText="DOB"/>
        <Button text="Remove" onAction="#handleRemoveStudent"/>
      </GridPane>
    </Tab>

    <!-- ENROLL TAB -->
    <Tab text="Enroll">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="enrollFnameField" promptText="First Name"/>
        <TextField fx:id="enrollLnameField" promptText="Last Name"/>
        <TextField fx:id="enrollDobField" promptText="DOB"/>
        <TextField fx:id="enrollCourseField" promptText="Course"/>
        <TextField fx:id="enrollPeriodField" promptText="Period"/>
        <Button text="Enroll" onAction="#handleEnroll"/>
      </GridPane>
    </Tab>

    <!-- DROP TAB -->
    <Tab text="Drop">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="dropFnameField" promptText="First Name"/>
        <TextField fx:id="dropLnameField" promptText="Last Name"/>
        <TextField fx:id="dropDobField" promptText="DOB"/>
        <TextField fx:id="dropCourseField" promptText="Course"/>
        <TextField fx:id="dropPeriodField" promptText="Period"/>
        <Button text="Drop" onAction="#handleDrop"/>
      </GridPane>
    </Tab>

    <!-- CLOSE SECTION TAB -->
    <Tab text="Close Section">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="closeCourseField" promptText="Course"/>
        <TextField fx:id="closePeriodField" promptText="Period"/>
        <Button text="Close Section" onAction="#handleCloseSection"/>
      </GridPane>
    </Tab>

    <!-- OFFER SECTION TAB -->
    <Tab text="Offer Section">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="offerCourseField" promptText="Course"/>
        <TextField fx:id="offerPeriodField" promptText="Period"/>
        <TextField fx:id="offerInstructorField" promptText="Instructor"/>
        <TextField fx:id="offerRoomField" promptText="Classroom"/>
        <Button text="Offer Section" onAction="#handleOfferSection"/>
      </GridPane>
    </Tab>

    <!-- SCHOLARSHIP TAB -->
    <Tab text="Scholarship">
      <GridPane hgap="10" vgap="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <TextField fx:id="scholarFnameField" promptText="First Name"/>
        <TextField fx:id="scholarLnameField" promptText="Last Name"/>
        <TextField fx:id="scholarDobField" promptText="DOB"/>
        <TextField fx:id="scholarAmountField" promptText="Amount"/>
        <Button text="Set Scholarship" onAction="#handleScholarship"/>
      </GridPane>
    </Tab>

    <!-- LOAD TAB -->
    <Tab text="Load Students">
      <VBox spacing="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button text="Load Students from File" onAction="#handleLoad"/>
      </VBox>
    </Tab>

    <!-- TUITION TAB -->
    <Tab text="Tuition">
      <VBox spacing="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button text="Print Tuition" onAction="#handleTuition"/>
      </VBox>
    </Tab>

    <!-- GRADUATES TAB -->
    <Tab text="Graduates">
      <VBox spacing="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Button text="Print Graduates" onAction="#handleGraduates"/>
      </VBox>
    </Tab>

    <!-- OUTPUT TAB -->
    <Tab text="Output">
      <VBox spacing="10">
        <padding>
          <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <TextArea fx:id="outputArea" prefHeight="400"/>

        <HBox spacing="10">
          <Button text="Print Students" onAction="#handlePrintStudents"/>
          <Button text="Print Schedule" onAction="#handlePrintSchedule"/>
          <Button text="Clear" onAction="#handleClear"/>
        </HBox>
      </VBox>
    </Tab>

  </tabs>

</TabPane>